{
	# Detras de Cloudflare: el puerto 80 sirve la web (no redirige) para evitar bucles con SSL Flexible
	auto_https disable_redirects
	servers {
		# Cloudflare hace de proxy: confiamos en sus rangos para conservar la IP real del jugador
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(rutas) {
	# Las paginas HTML siempre se revalidan (evita que el navegador muestre versiones viejas)
	@paginas path /home /admin /admin/chat /profile /profile/ /profile/cuenta
	header @paginas Cache-Control "no-cache"

	handle /home* {
		reverse_proxy app:8000
	}
	handle /admin* {
		reverse_proxy app:8000
	}
	handle /profile* {
		reverse_proxy reto6:8000
	}
	handle / {
		header Cache-Control "no-store"
		redir * /home 302
	}
	handle {
		respond "CobraBot CTF" 200
	}
}

(tls_cf) {
	# TLS-ALPN no funciona detras del proxy de Cloudflare: solo HTTP-01
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
}

https://cobrabotctf.top {
	import tls_cf
	import rutas
}

https://www.cobrabotctf.top {
	import tls_cf
	redir https://cobrabotctf.top{uri} permanent
}

# Acceso directo por IP (sin dominio), como hasta ahora
:80 {
	@www host www.cobrabotctf.top
	redir @www https://cobrabotctf.top{uri} permanent
	import rutas
}
