# Config del stack CobraBot CTF. Copia este fichero a .env y rellena LLM_API_KEY.
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux/Mac)

# ---- Login del panel admin (reto 5) ----
ADMIN_USER=cb_root
ADMIN_PASSWORD=Ih8hackers
# hash MD5 de la contrasena de arriba (es lo que el bot puede acabar filtrando)
ADMIN_HASH_MD5=6998c63942be0e68f11b6da70137c181
FLAG=CTF{tu_flag_reto5}

# ---- Flag de la tienda (reto 4): pedido a 0 EUR ----
SHOP_FLAG=CTF{tu_flag_reto4}

# ---- Flag del panel de cliente (reto 6): JWT alg:none ----
RETO6_FLAG=CTF{tu_flag_reto6}
JWT_SECRET=pon-aqui-un-secreto-cualquiera

# ---- LLM del chatbot (OpenRouter u otra API compatible con OpenAI) ----
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=tu_api_key_aqui
LLM_MODEL=meta-llama/llama-3.1-8b-instruct

# ---- Captcha Turnstile (en local, desactivado) ----
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- Defensas del reto 5 (ajustan dificultad) ----
FILTER_ENABLED=true
OUTPUT_FILTER_ENABLED=false
MAX_HISTORY_TURNS=8

# ---- Solo produccion (VPS con dominio) ----
DOMAIN=localhost
